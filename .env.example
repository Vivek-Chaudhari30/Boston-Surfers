# Copy to apps/web/.env.local for local dev, and add the same keys in Vercel.
# /dev/game and /dev/dispenser work with none of these set.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# MBTA V3 API key from https://api-v3.mbta.com (server only)
MBTA_API_KEY=

# Generate each with: openssl rand -base64 32
SESSION_SECRET=
KIOSK_SECRET=

# Public base URL used in the kiosk join QR (http://<mac-ip>:3000 on LAN, or the Vercel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Minimum active riders in a car before a prize is awarded
PRIZE_MIN_RIDERS=1
