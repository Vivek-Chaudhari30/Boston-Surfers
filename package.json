{
  "name": "constant-buffers",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "pnpm --filter @cb/web dev",
    "build": "pnpm --filter @cb/web build",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p scripts/tsconfig.json",
    "lint": "pnpm -r --parallel lint",
    "test": "pnpm -r test",
    "kiosk": "pnpm --filter @cb/web kiosk"
  },
  "devDependencies": {
    "@cb/shared": "workspace:*",
    "@types/node": "^26",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "zod": "^4.6.7",
    "@supabase/supabase-js": "^2.119.2"
  },
  "type": "module"
}
